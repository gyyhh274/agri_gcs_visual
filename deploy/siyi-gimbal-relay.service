[Unit]
Description=SIYI A8 mini gimbal UDP relay (ground station to camera)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/siyi_gimbal_relay.py
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=siyi-gimbal-relay

[Install]
WantedBy=multi-user.target
